{
  "manifest_version": 3,
  "name": "Krishnala Wallet (KRIS)",
  "version": "1.1.0",
  "description": "KRIS wallet — Krishnala testnet + mainnet pre-configured. EVM-compatible.",
  "action": { "default_popup": "popup.html", "default_title": "Krishnala Wallet" },
  "icons": { "16": "logo.png", "48": "logo.png", "128": "logo.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://rpc.krishnala.com/*",
    "https://rpc-mainnet.krishnala.com/*",
    "https://faucet.krishnala.com/*"
  ]
}
